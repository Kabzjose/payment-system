cat << 'EOF' > .gitignore
# Dependencies
node_modules/
/jspm_packages/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local env variables / Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.sample
!.env.example

# Production builds
dist/
build/
.next/
.nuxt/
out/

# Editor / IDE settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS temporary files
.DS_Store
Thumbs.db
EOF
